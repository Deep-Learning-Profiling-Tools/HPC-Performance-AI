# project-local environments and tools (machine-specific, never committed)
.conda_env/
.venv/
.tools/
_upstream/
.deps/
build/
cmake-build-*/
results/

# python
__pycache__/
*.pyc

# editors / OS
.vscode/
.idea/
.DS_Store

# profiler output
*.ncu-rep
*.nsys-rep
*.sqlite
rocprof*.csv
rocprof*.json

# Level 3 source distribution (Git LFS source bundles + materialization, 2026-09-08)
# materialized source trees and per-run agent workspaces are never committed
level3/*/src/
level3/*/deps/
level3/*/.hpcperf-materialized.yaml
level3/*/.materialize.tmp.*
level3/*/.discarded-*
workspaces/
# GUARD (remove when git-lfs is configured on the clone, see level3/SOURCE_ARCHIVES.md): without the
# LFS filter a `git add` would commit the archives as plain blobs
level3/*/archives/*.tar.zst
